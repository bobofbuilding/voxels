{
  "compilerOptions": {
    "skipLibCheck": true,
    "sourceMap": true,
    "lib": ["es2022", "dom", "dom.iterable", "webworker.importscripts"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",

    "target": "ES6",
    "typeRoots": ["./node_modules/@types", "./node_modules"],
    "types": ["babylonjs", "babylonjs-gui", "node", "@webgpu/types"],
    "experimentalDecorators": true,
    "strict": true,
    "module": "ES2022",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "importHelpers": true,
    "allowSyntheticDefaultImports": true,
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "exclude": ["render", "renderer"]

}
